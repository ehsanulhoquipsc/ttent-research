{%- set L = lang or "en" -%}{%- set t = i18n[L] -%}{%- set p = "/bn" if L == "bn" else "" -%}
{#- About page text is edited in the admin panel and stored in src/_data/about.json -#}
{%- set c = about[L] -%}
<div class="wrap">
  <header class="page-head two-col">
    <div>
      <p class="kicker">{{ c.kicker }}</p>
      <h1 class="page-title">{{ c.title }}</h1>
      <p class="lede">{{ c.lede }}</p>
    </div>
    <div class="about-mark"><img src="/assets/img/mark.svg" alt="" width="160" height="192"></div>
  </header>

  <section class="block" aria-labelledby="pillars">
    <h2 id="pillars">{{ c.pillarsTitle }}</h2>
    <div class="pillars">
      {% for pl in c.pillars %}<div class="pillar"><span class="num">{{ loop.index | num(L) }}</span><h3>{{ pl.title }}</h3><p>{{ pl.text }}</p></div>{% endfor %}
    </div>
  </section>

  <section class="block" aria-labelledby="how">
    <h2 id="how">{{ c.stepsTitle }}</h2>
    <ol class="steps">
      {% for s in c.steps %}<li><p class="kicker">{{ c.stepLabel }} {{ loop.index | num(L) }}</p><strong>{{ s.title }}</strong><span>{{ s.text }}</span></li>{% endfor %}
    </ol>
  </section>
</div>

<section class="quote-band">
  <p>“{{ c.quote }}”</p>
  <span lang="en">{{ site.name }}</span>
</section>
