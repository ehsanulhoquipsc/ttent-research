{%- set L = lang or "en" -%}{%- set t = i18n[L] -%}{%- set p = "/bn" if L == "bn" else "" -%}
{%- set list = collections.reports | limit(7) | cards(L, collections.reportsBn) -%}
{%- set featured = list | first -%}
<div class="narrow">
  {% if featured %}
  <section class="featured" aria-labelledby="featured-title">
    <p class="kicker">{{ t.featured }}</p>
    <h1 id="featured-title"{% if L == "bn" and not featured.translated %} lang="en"{% elif L == "en" and featured.bnOriginal %} lang="bn"{% endif %}><a href="{{ featured.url }}">{{ featured.title }}</a></h1>
    <p class="standfirst"{% if L == "bn" and not featured.translated %} lang="en"{% elif L == "en" and featured.bnOriginal %} lang="bn"{% endif %}>{{ featured.description }}</p>
    <p class="featured-links">
      <time datetime="{{ featured.date | isoDate }}">{{ featured.date | readableDate(L) }}</time>
      <a href="{{ featured.url }}">{{ t.readOnline }}</a>
      {% if featured.pdf %}<a href="{{ featured.pdf }}" download>{{ t.downloadPdf }}</a>{% endif %}
      {% if L == "bn" and not featured.translated %}<span class="badge">{{ t.englishOnly }}</span>{% endif %}
    </p>
  </section>
  {% endif %}

  <section aria-labelledby="latest-title">
    <div class="section-head">
      <h2 id="latest-title">{{ t.latest }}</h2>
      <a href="{{ p }}/research/">{{ t.viewAll }}</a>
    </div>
    {% for c in list %}{% if not loop.first %}{% include "partials/report-card.njk" %}{% endif %}{% endfor %}
  </section>
</div>
