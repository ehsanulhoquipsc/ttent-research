{%- set L = lang or "en" -%}{%- set t = i18n[L] -%}{%- set p = "/bn" if L == "bn" else "" -%}
{%- if L == "bn" -%}
{%- set c = {
  title: "যোগাযোগ করুন",
  lede: "কোনো প্রতিবেদন নিয়ে প্রশ্ন, গবেষণার নতুন ভাবনা, নাকি আমাদের সঙ্গে যুক্ত হতে চান? বার্তা পাঠান, আমরা ইমেইলে উত্তর দেব।",
  email: "ইমেইল", follow: "অনুসরণ করুন",
  name: "আপনার নাম", emailField: "ইমেইল", reason: "বিষয় কী?", message: "বার্তা", send: "বার্তা পাঠান",
  reasons: ["কোনো প্রতিবেদন নিয়ে প্রশ্ন", "গবেষণার নতুন ভাবনা", "গবেষক বা পর্যালোচক হিসেবে যুক্ত হতে চাই", "বাংলা অনুবাদ", "অন্য কিছু"],
  note: "আপনার তথ্য শুধু উত্তর দেওয়ার কাজে ব্যবহার করা হবে। বিস্তারিত দেখুন আমাদের",
  privacy: "গোপনীয়তা নীতিতে",
  honeypot: "এই ঘরটি খালি রাখুন"
} -%}
{%- else -%}
{%- set c = {
  title: "Contact us",
  lede: "Questions about a report, an idea for research, or want to join us? Send a message and we will reply by email.",
  email: "Email", follow: "Follow us",
  name: "Your name", emailField: "Email", reason: "What is it about?", message: "Message", send: "Send message",
  reasons: ["A question about a report", "An idea for research", "Joining as a researcher or reviewer", "Bangla translation", "Something else"],
  note: "We use your details only to reply to you. See our",
  privacy: "Privacy policy",
  honeypot: "Leave this empty"
} -%}
{%- endif -%}
{%- set reasonValues = ["A question about a report", "An idea for research", "Joining as a researcher or reviewer", "Bangla translation", "Something else"] -%}
<div class="wrap">
  <div class="page-head two-col">
    <div>
      <h1 class="page-title">{{ c.title }}</h1>
      <p class="lede">{{ c.lede }}</p>
      <div class="contact-list">
        {% if site.contactEmail %}<div><span class="label">{{ c.email }}</span><a href="mailto:{{ site.contactEmail }}" lang="en">{{ site.contactEmail }}</a></div>{% endif %}
        {% if site.social.length %}<div><span class="label">{{ c.follow }}</span><span lang="en">{% for s in site.social %}<a href="{{ s.url }}">{{ s.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span></div>{% endif %}
      </div>
    </div>

    <!-- Netlify collects these messages automatically (Site → Forms). Both languages use the same form. -->
    <form class="form" name="contact" method="POST" action="{{ p }}/contact/thanks/" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="contact">
      <input type="hidden" name="language" value="{{ L }}">
      <p hidden><label>{{ c.honeypot }} <input name="company"></label></p>
      <div class="field"><label for="name">{{ c.name }}</label><input id="name" name="name" type="text" required autocomplete="name"></div>
      <div class="field"><label for="email">{{ c.emailField }}</label><input id="email" name="email" type="email" required autocomplete="email"></div>
      <div class="field"><label for="reason">{{ c.reason }}</label>
        <select id="reason" name="reason">
          {% for r in c.reasons %}<option value="{{ reasonValues[loop.index0] }}">{{ r }}</option>{% endfor %}
        </select>
      </div>
      <div class="field"><label for="message">{{ c.message }}</label><textarea id="message" name="message" rows="6" required></textarea></div>
      <div><button class="btn btn-primary" type="submit">{{ c.send }}</button></div>
      <p class="form-note">{{ c.note }} <a href="/privacy/">{{ c.privacy }}</a>{{ "।" if L == "bn" else "." }}</p>
    </form>
  </div>
</div>
