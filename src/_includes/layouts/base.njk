{%- set L = lang or ("bn" if language == "bn" else "en") -%}
{%- set t = i18n[L] -%}
{%- set p = "/bn" if L == "bn" else "" -%}
{%- if L == "bn" and language == "bn" and not lang -%}
  {#- a report written in Bangla with no English edition -#}
  {%- set bnUrl = page.url -%}
  {%- set enUrl = "/research/" -%}
  {%- set hasPair = false -%}
{%- elif L == "bn" -%}
  {%- set bnUrl = page.url -%}
  {%- set enUrl = page.url | replace("/bn/", "/") -%}
  {%- set hasPair = true -%}
{%- else -%}
  {%- set enUrl = page.url -%}
  {%- set bnUrl = altBn or (("/bn" + page.url) if hasBn else "/bn/") -%}
  {%- set hasPair = altBn or hasBn -%}
{%- endif -%}
{%- set desc = description or summary or (site.descriptionBn if L == "bn" else site.description) -%}
<!doctype html>
<html lang="{{ L }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ desc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if hasPair %}
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
  <link rel="alternate" hreflang="bn" href="{{ site.url }}{{ bnUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ enUrl }}">
  {% endif %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ 'bn_BD' if L == 'bn' else 'en_AU' }}">
  <meta property="og:type" content="{% if topic %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ thumbnail or '/assets/img/og-image.png' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#111111">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon.png" type="image/png" sizes="64x64">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  {% if L == "bn" %}
  <link rel="preload" href="/assets/fonts/noto-serif-bengali-bengali-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% else %}
  <link rel="preload" href="/assets/fonts/ibm-plex-serif-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% endif %}
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">{{ t.skip }}</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="{{ p }}/" aria-label="{{ site.name }}">
        <svg class="mark" width="25" height="30" viewBox="0 0 40 48" aria-hidden="true"><path d="M0 0h28l12 12v36H0Z" fill="#FFFFFF"/><path d="M28 0v12h12Z" fill="#E0463B"/><path fill="#111111" fill-rule="evenodd" d="M9 16h9.5c6.6 0 10.5 4.5 10.5 10.5S25.1 37 18.5 37H9V16Zm4.8 4.2v12.6h4.4c3.7 0 6-2.5 6-6.3s-2.3-6.3-6-6.3h-4.4Z"/></svg>
        <span class="brand-name" lang="en">{{ site.name | upper }}</span>
      </a>
      <div class="header-right">
        <nav class="main-nav" aria-label="{{ t.research }}">
          <a href="{{ p }}/research/" {% if section == "research" %}aria-current="page"{% endif %}>{{ t.research }}</a>
          <a href="{{ p }}/topics/" {% if section == "topics" %}aria-current="page"{% endif %}>{{ t.topics }}</a>
          <a href="{{ p }}/about/" {% if section == "about" %}aria-current="page"{% endif %}>{{ t.about }}</a>
        </nav>
        <nav class="lang-toggle" aria-label="{{ t.language }}">
          <a href="{{ enUrl }}" lang="en" hreflang="en" {% if L == "en" %}aria-current="true"{% endif %}>EN</a>
          <a href="{{ bnUrl }}" lang="bn" hreflang="bn" {% if L == "bn" %}aria-current="true"{% endif %}>বাংলা</a>
        </nav>
        <a class="icon-btn" href="{{ p }}/search/" aria-label="{{ t.searchResearch }}" {% if section == "search" %}aria-current="page"{% endif %}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <a class="footer-name" href="{{ p }}/" aria-label="{{ site.name }}"><svg class="mark" width="30" height="36" viewBox="0 0 40 48" aria-hidden="true"><path d="M0 0h28l12 12v36H0Z" fill="#FFFFFF"/><path d="M28 0v12h12Z" fill="#E0463B"/><path fill="#111111" fill-rule="evenodd" d="M9 16h9.5c6.6 0 10.5 4.5 10.5 10.5S25.1 37 18.5 37H9V16Zm4.8 4.2v12.6h4.4c3.7 0 6-2.5 6-6.3s-2.3-6.3-6-6.3h-4.4Z"/></svg><span lang="en">{{ site.name | upper }}</span></a>
      <nav class="footer-cols" aria-label="{{ t.organisation }}">
        <div class="footer-col">
          <p class="footer-head">{{ t.research }}</p>
          <a href="{{ p }}/research/">{{ t.allResearch }}</a>
          <a href="{{ p }}/topics/">{{ t.topics }}</a>
          <a href="{{ p }}/search/">{{ t.search }}</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">{{ t.organisation }}</p>
          <a href="{{ p }}/about/">{{ t.about }}</a>
          <a href="/editorial-policy/">{{ t.editorialPolicy }}</a>
          <a href="{{ p }}/contact/">{{ t.contact }}</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">{{ t.legal }}</p>
          <a href="/privacy/">{{ t.privacy }}</a>
          <a href="/terms/">{{ t.terms }}</a>
          <a href="/copyright/">{{ t.copyright }}</a>
          <a href="/disclaimer/">{{ t.disclaimer }}</a>
          <a href="/accessibility/">{{ t.accessibility }}</a>
        </div>
        {% if site.social.length %}
        <div class="footer-col">
          <p class="footer-head">{{ t.follow }}</p>
          {% for s in site.social %}<a href="{{ s.url }}" rel="noopener" lang="en">{{ s.name }}</a>{% endfor %}
        </div>
        {% endif %}
      </nav>
    </div>
    <div class="wrap footer-bottom">
      {% if L == "bn" %}
      <p>© {{ buildYear | num("bn") | replace(",", "") }} Doctren। অন্যভাবে উল্লেখ না থাকলে প্রতিবেদনগুলো <a href="{{ site.legal.contentLicence.url }}" rel="license noopener" lang="en">{{ site.legal.contentLicence.short }}</a> লাইসেন্সের অধীনে প্রকাশিত। {{ t.legalEnglishNote }}</p>
      {% else %}
      <p>© {{ buildYear }} {{ site.name }}. Reports are licensed under <a href="{{ site.legal.contentLicence.url }}" rel="license noopener">{{ site.legal.contentLicence.short }}</a> unless otherwise stated.</p>
      {% endif %}
    </div>
  </footer>
</body>
</html>
