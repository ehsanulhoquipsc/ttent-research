<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  {% if thumbnail %}<meta property="og:image" content="{{ site.url }}{{ thumbnail }}">{% endif %}
  <link rel="icon" href="/assets/img/emblem.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <img src="/assets/img/emblem.png" alt="" width="40" height="50">
        <span><span class="brand-name">{{ site.name }}</span><span class="brand-tag">{{ site.tagline }}</span></span>
      </a>
      <nav class="main-nav" aria-label="Main">
        <a href="/research/" {% if section == "research" %}aria-current="page"{% endif %}>Research</a>
        <a href="/topics/" {% if section == "topics" %}aria-current="page"{% endif %}>Topics</a>
        <a href="/about/" {% if section == "about" %}aria-current="page"{% endif %}>About</a>
        <a class="icon-btn" href="/search/" aria-label="Search research" {% if section == "search" %}aria-current="page"{% endif %}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="footer-name" href="/">{{ site.name }}</a>
      <nav aria-label="Social media" class="social">
        {% for s in site.social %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% endfor %}
        <a href="/contact/">Contact</a>
      </nav>
    </div>
  </footer>
</body>
</html>
