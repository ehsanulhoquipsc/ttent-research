<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or summary or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if topic %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or summary or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ thumbnail or '/assets/img/emblem.png' }}">
  <meta name="twitter:card" content="{% if thumbnail %}summary_large_image{% else %}summary{% endif %}">
  <link rel="icon" href="/assets/img/emblem.png">
  <link rel="preload" href="/assets/fonts/newsreader-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <img src="/assets/img/emblem.png" alt="" width="40" height="50">
        <span><span class="brand-name">{{ site.name }}</span><span class="brand-tag">{{ site.tagline }}</span></span>
      </a>
      <nav class="main-nav" aria-label="Main">
        <a href="/research/" {% if section == "research" %}aria-current="page"{% endif %}>Research</a>
        <a href="/topics/" {% if section == "topics" %}aria-current="page"{% endif %}>Topics</a>
        <a href="/about/" {% if section == "about" %}aria-current="page"{% endif %}>About</a>
        <a class="icon-btn" href="/search/" aria-label="Search research" {% if section == "search" %}aria-current="page"{% endif %}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <a class="footer-name" href="/">{{ site.name }}</a>
      <nav class="footer-cols" aria-label="Footer">
        <div class="footer-col">
          <p class="footer-head">Research</p>
          <a href="/research/">All research</a>
          <a href="/topics/">Topics</a>
          <a href="/search/">Search</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">Organisation</p>
          <a href="/about/">About</a>
          <a href="/editorial-policy/">Editorial policy</a>
          <a href="/contact/">Contact</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">Legal</p>
          <a href="/privacy/">Privacy policy</a>
          <a href="/terms/">Terms of use</a>
          <a href="/copyright/">Copyright &amp; licensing</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/accessibility/">Accessibility</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">Follow</p>
          {% for s in site.social %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% endfor %}
        </div>
      </nav>
    </div>
    <div class="wrap footer-bottom">
      <p>© {{ site.legal.lastUpdated | year }} {{ site.name }}. Reports are licensed under <a href="{{ site.legal.contentLicence.url }}" rel="license noopener">{{ site.legal.contentLicence.short }}</a> unless otherwise stated.</p>
      <p>{{ site.legal.entityName }} · ABN {{ site.legal.abn }}</p>
    </div>
  </footer>
</body>
</html>
