<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or summary or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if topic %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or summary or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ thumbnail or '/assets/img/og-image.png' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#111111">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon.png" type="image/png" sizes="64x64">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/ibm-plex-serif-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="{{ site.name }} home">
        <svg class="mark" width="25" height="30" viewBox="0 0 40 48" aria-hidden="true"><path d="M0 0h28l12 12v36H0Z" fill="#FFFFFF"/><path d="M28 0v12h12Z" fill="#E0463B"/><path fill="#111111" fill-rule="evenodd" d="M9 16h9.5c6.6 0 10.5 4.5 10.5 10.5S25.1 37 18.5 37H9V16Zm4.8 4.2v12.6h4.4c3.7 0 6-2.5 6-6.3s-2.3-6.3-6-6.3h-4.4Z"/></svg>
        <span class="brand-name">{{ site.name | upper }}</span>
      </a>
      <nav class="main-nav" aria-label="Main">
        <a href="/research/" {% if section == "research" %}aria-current="page"{% endif %}>Research</a>
        <a href="/topics/" {% if section == "topics" %}aria-current="page"{% endif %}>Topics</a>
        <a href="/about/" {% if section == "about" %}aria-current="page"{% endif %}>About</a>
        <a class="icon-btn" href="/search/" aria-label="Search research" {% if section == "search" %}aria-current="page"{% endif %}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <a class="footer-name" href="/" aria-label="{{ site.name }} home"><svg class="mark" width="30" height="36" viewBox="0 0 40 48" aria-hidden="true"><path d="M0 0h28l12 12v36H0Z" fill="#FFFFFF"/><path d="M28 0v12h12Z" fill="#E0463B"/><path fill="#111111" fill-rule="evenodd" d="M9 16h9.5c6.6 0 10.5 4.5 10.5 10.5S25.1 37 18.5 37H9V16Zm4.8 4.2v12.6h4.4c3.7 0 6-2.5 6-6.3s-2.3-6.3-6-6.3h-4.4Z"/></svg><span>{{ site.name | upper }}</span></a>
      <nav class="footer-cols" aria-label="Footer">
        <div class="footer-col">
          <p class="footer-head">Research</p>
          <a href="/research/">All research</a>
          <a href="/topics/">Topics</a>
          <a href="/search/">Search</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">Organisation</p>
          <a href="/about/">About</a>
          <a href="/editorial-policy/">Editorial policy</a>
          <a href="/contact/">Contact</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">Legal</p>
          <a href="/privacy/">Privacy policy</a>
          <a href="/terms/">Terms of use</a>
          <a href="/copyright/">Copyright &amp; licensing</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/accessibility/">Accessibility</a>
        </div>
        <div class="footer-col">
          <p class="footer-head">Follow</p>
          {% for s in site.social %}<a href="{{ s.url }}" rel="noopener">{{ s.name }}</a>{% endfor %}
        </div>
      </nav>
    </div>
    <div class="wrap footer-bottom">
      <p>© {{ site.legal.lastUpdated | year }} {{ site.name }}. Reports are licensed under <a href="{{ site.legal.contentLicence.url }}" rel="license noopener">{{ site.legal.contentLicence.short }}</a> unless otherwise stated.</p>
      <p>{{ site.legal.entityName }} · ABN {{ site.legal.abn }}</p>
    </div>
  </footer>
</body>
</html>
