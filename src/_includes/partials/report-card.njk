<article class="card"{% if L == "bn" and not c.translated %} lang="en"{% endif %}>
  <div class="card-text">
    <h3 class="card-title"><a href="{{ c.url }}">{{ c.title }}</a></h3>
    <p class="card-desc">{{ c.description }}</p>
    <p class="meta" lang="{{ L }}">{{ c.topic | topicName(L) }} · <time datetime="{{ c.date | isoDate }}">{{ c.date | readableDate(L) }}</time>
      {%- if L == "en" and c.hasBn %} · <span class="badge" lang="bn">{{ t.banglaBadge }}</span>{% endif %}
      {%- if L == "bn" and not c.translated %} · <span class="badge">{{ t.englishOnly }}</span>{% endif %}</p>
  </div>
  <a class="thumb{% if not c.thumbnail %} thumb--empty{% endif %}" href="{{ c.url }}" tabindex="-1" aria-hidden="true">
    {% if c.thumbnail %}<img src="{{ c.thumbnail }}" alt="" loading="lazy">{% else %}<span lang="{{ L }}">{{ c.topic | topicName(L) }}</span>{% endif %}
  </a>
</article>
