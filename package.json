{
  "name": "doctren",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Doctren research site \u2014 static HTML/CSS site built with Eleventy",
  "scripts": {
    "build": "eleventy && pagefind --site _site --force-language en",
    "start": "eleventy --serve",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "pagefind": "^1.1.0"
  }
}
